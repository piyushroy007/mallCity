{
  "name": "mallcity-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MallCity - Unified Monorepo with Angular, NgRx, Angular Material, TypeScript, Express, and MongoDB",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@mallcity/api run dev",
    "dev:web": "npm --workspace=@mallcity/web run start",
    "build:api": "npm --workspace=@mallcity/api run build",
    "build:web": "npm --workspace=@mallcity/web run build",
    "build": "npm run build:api && npm run build:web",
    "seed:admin": "npm --workspace=@mallcity/api run seed:admin",
    "sync:indexes": "npm --workspace=@mallcity/api run sync:indexes",
    "lint": "echo \"Running monorepo linting...\"",
    "format": "npx prettier --write \"**/*.{ts,js,json,scss,html,md}\""
  },
  "keywords": [
    "mallcity",
    "monorepo",
    "angular",
    "ngrx",
    "express",
    "typescript",
    "mongodb",
    "mongoose"
  ],
  "author": "Piyush Roy",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  }
}
